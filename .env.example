# Google Cloud project that hosts the BigQuery datasets
GCP_PROJECT_ID=your-gcp-project-id
# Raw dataset for ingestion (dbt builds staging/marts in their own datasets)
BQ_DATASET=hmda_raw
# BigQuery location (US recommended: HMDA is US data)
BQ_LOCATION=US
# Path to a service-account JSON key (never commit it)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key
